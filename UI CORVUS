local function getCustomIcon(path)
	if bundledIcons[path] then
		pcall(function()
			if not isfile(path) then
				writefile(path, base64_decode(bundledIcons[path]))
			end
		end)
	end
	local ok, asset = pcall(function()
		return getcustomasset(path)
	end)
	return ok and asset or ""
end

local function animateIn(object, interactive, entrance)
	local scale = Instance.new("UIScale", object)
	scale.Scale = entrance == false and 1 or 0.975
	local shadow
	if object:IsA("Frame") or object:IsA("TextButton") then
		pcall(function()
			shadow = Instance.new("UIShadow", object)
			shadow.Name = "DepthShadow"
			shadow.BlurRadius = UDim.new(0, 7)
			shadow.Color = Color3.new()
			shadow.Transparency = 0.95
			shadow.ZIndex = -1
			shadow.ShowBehindParent = true
		end)
	end
	if entrance ~= false then
		task.defer(function()
			if object.Parent then
				TweenService
					:Create(scale, TweenInfo.new(0.34, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Scale = 1 })
					:Play()
			end
		end)
	end
	if interactive ~= false and shadow then
		object.MouseEnter:Connect(function()
			local info = TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			TweenService:Create(scale, info, { Scale = 1.002 }):Play()
			TweenService:Create(shadow, info, { Transparency = 0.86 }):Play()
		end)
		object.MouseLeave:Connect(function()
			local info = TweenInfo.new(0.24, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
			TweenService:Create(scale, info, { Scale = 1 }):Play()
			TweenService:Create(shadow, info, { Transparency = 0.95 }):Play()
		end)
	end
	return scale, shadow
end

