local callbacks = {}
local alive = true
local STATE = {}
function STATE.alive() return alive end
function STATE.onCleanup(callback) table.insert(callbacks, callback) end
local function teardown()
 if not alive then return end
 alive = false
 for i = #callbacks, 1, -1 do pcall(callbacks[i]) end
 table.clear(callbacks)
end
env.__FoccusStandaloneCleanup = teardown


local connections = {}
local function track(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end
local function cleanup()
    for _, connection in ipairs(connections) do connection:Disconnect() end
    table.clear(connections)
end
