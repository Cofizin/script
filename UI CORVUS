  if drag and (input==drag or input.UserInputType==Enum.UserInputType.MouseButton1) then
   if moved then lastDragEnd=os.clock() end drag=nil
  end
 end)
 connect(toggle.Activated,function()
  if moved or (lastDragEnd and os.clock()-lastDragEnd<.15) then return end
  setMinimized(false)
 end)
 connect(gui.Destroying,function() for _,c in ipairs(connections) do c:Disconnect() end end)
end

local function applyVisualStyle(instance)
 if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
  local face=instance.FontFace
  instance.FontFace=Font.new("rbxasset://fonts/families/Roboto.json",face.Weight,face.Style)
 elseif instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
  local name=string.lower(instance.Name)
  local navigationIcon=instance.Parent and instance.Parent.Name=="TabButton"
  if (string.find(name,"icon",1,true) or string.find(name,"lucide",1,true)) and not navigationIcon then
   instance.Visible = false
  end
 end
 if (instance:IsA("Frame") or instance:IsA("TextButton")) and instance.Parent and instance.Parent:IsA("ScrollingFrame") and instance.Parent~=sidebar and not instance:FindFirstChild("SurfaceGradient") then
  local name=instance.Name
  if string.match(name,"Paragraph$") or string.match(name,"Toggle$") or string.match(name,"Button$") or string.match(name,"Slider$") or string.match(name,"Dropdown$") or string.match(name,"Input$") then
   make("UIGradient",instance,{Name="SurfaceGradient",Rotation=105,Color=ColorSequence.new({ColorSequenceKeypoint.new(0,Theme.GoldGlow),ColorSequenceKeypoint.new(.48,Theme.Gold),ColorSequenceKeypoint.new(1,Theme.GoldDeep)})})
  end
 end
end
for _,instance in ipairs(frame:GetDescendants()) do applyVisualStyle(instance) end
track(frame.DescendantAdded,applyVisualStyle)
return window
end
