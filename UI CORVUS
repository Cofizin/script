	function Window:_refreshTabOrder()
		for index, tab in ipairs(self._tabs) do
			tab.Button.LayoutOrder = index
		end
	end

	function Window:_moveTab(tab, direction)
		local index = table.find(self._tabs, tab)
		local target = index and index + direction
		local neighbour = target and self._tabs[target]
		if not index or not neighbour or neighbour.Pinned ~= tab.Pinned then
			return
		end
		self._tabs[index], self._tabs[target] = self._tabs[target], self._tabs[index]
		self:_refreshTabOrder()
	end

	function Window:_setTabPinned(tab, pinned)
		local index = table.find(self._tabs, tab)
		if not index then
			return
		end
		table.remove(self._tabs, index)
		tab.Pinned = pinned == true
		if tab.PinStar then
			tab.PinStar.Visible = tab.Pinned
		end
		local insertAt = 1
		while self._tabs[insertAt] and self._tabs[insertAt].Pinned do
			insertAt += 1
		end
		table.insert(self._tabs, insertAt, tab)
		self:_refreshTabOrder()
	end

