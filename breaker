local API="https://liquid-textile-multi-zoloft.trycloudflare.com"
local function startupNotice(message)
    warn("[Itachi Keys] "..message)
    pcall(function() game:GetService("StarterGui"):SetCore("SendNotification",{Title="Itachi Hub · Keys",Text=message,Duration=8}) end)
end
startupNotice("Starting key loader...")
if not game:IsLoaded() then
    startupNotice("Waiting for the game to load...")
    local deadline=os.clock()+30
    while not game:IsLoaded() and os.clock()<deadline do task.wait(.2) end
    if not game:IsLoaded() then startupNotice("Game loading timed out. Run the loader again after loading.");return end
end
if game.GameId~=10675117523 then
    startupNotice("Unsupported game ("..tostring(game.GameId).."). Anime Breaker only.")
    return
end
local env=getgenv()
if env.ItachiKeyPrompt then env.ItachiKeyPrompt:Destroy() end
local previous=env.ItachiLicenseSession
if previous then previous.alive=false;if previous.runtime and previous.runtime.Stop then task.spawn(function() pcall(previous.runtime.Stop) end) end end
local Http=game:GetService("HttpService")
local Players=game:GetService("Players")
local player=Players.LocalPlayer
while not player do task.wait(.1);player=Players.LocalPlayer end
local req=request or http_request or (syn and syn.request)
local cachePath="ItachiHub-breaker-key.txt"
local function validKey(value)
    return type(value)=="string" and #value==55 and value:match("^ITACHI%-%x+$")~=nil
end
local function cachedKey()
    if validKey(env.ItachiBreakerSavedKey) then return env.ItachiBreakerSavedKey end
    if type(readfile)=="function" then
        local ok,value=pcall(readfile,cachePath)
        if ok and validKey(value) then return value end
    end
end
local function saveKey(key)
    env.ItachiBreakerSavedKey=key
    if type(writefile)=="function" then pcall(writefile,cachePath,key) end
end
local function clearKey()
    env.ItachiBreakerSavedKey=nil
    if type(delfile)=="function" then pcall(delfile,cachePath) end
    if type(writefile)=="function" then pcall(writefile,cachePath,"") end
end
local rejected={INVALID_KEY=true,KEY_EXPIRED=true,KEY_REVOKED=true,HWID_MISMATCH=true,PRODUCT_DENIED=true}
local function call(route,payload)
    if not req then return nil,"HTTP_UNSUPPORTED" end
    local done,ok,response=false,false,nil
    task.spawn(function()
        ok,response=pcall(req,{Url=API..route,Method="POST",Headers={["Content-Type"]="application/json"},Body=Http:JSONEncode(payload),Timeout=12})
        done=true
    end)
    local deadline=os.clock()+15
    while not done and os.clock()<deadline do task.wait(.1) end
    if not done then return nil,"NETWORK_ERROR" end
    if not ok or type(response)~="table" then return nil,"NETWORK_ERROR" end
    local code=tonumber(response.StatusCode or response.Status) or 0
    if code==200 and route=="/v1/script" then return response.Body end
    local parsed,value=pcall(Http.JSONDecode,Http,response.Body or "")
    if code==200 and parsed and type(value)=="table" and value.ok==true then return value end
    return nil,parsed and type(value)=="table" and tostring(value.error or "REQUEST_FAILED") or "NETWORK_ERROR"
end
local messages={INVALID_KEY="Invalid key.",KEY_EXPIRED="Your key has expired.",KEY_REVOKED="Your key was revoked.",HWID_MISMATCH="Different device. Reset HWID using /my-key reset in Discord.",
    RATE_LIMITED="Too many attempts. Wait a minute.",NETWORK_ERROR="Cannot reach the key server. Please try again.",SCRIPT_UNAVAILABLE="Script unavailable. Contact support.",
    INVALID_DEVICE="Your executor did not provide a valid device identifier.",HTTP_UNSUPPORTED="This executor does not support HTTP requests."}
