Instance.new("UICorner",activate).CornerRadius=UDim.new(0,6)
local buy=Instance.new("TextButton",panel);buy.Position=UDim2.fromOffset(20,216);buy.Size=UDim2.new(1,-40,0,30)
buy.Text="Buy your key here";buy.TextColor3=Color3.fromRGB(255,110,135);buy.BackgroundColor3=Color3.fromRGB(35,16,24);buy.Font=Enum.Font.GothamBold;buy.TextSize=13
Instance.new("UICorner",buy).CornerRadius=UDim.new(0,6)
buy.Activated:Connect(function()
    local copy=setclipboard or toclipboard
    if type(copy)=="function" then
        local ok=pcall(copy,"https://discord.gg/kSZhAnqWqv")
        status.Text=ok and "Discord invite copied!" or "discord.gg/kSZhAnqWqv"
    else status.Text="discord.gg/kSZhAnqWqv" end
end)
local busy=false
local function activateKey(saved)
    if busy then return end
    busy=true;status.Text="Checking license..."
    local ok,failure=pcall(function()
        if type(gethwid)~="function" then error("This executor does not expose gethwid(). Contact support.",0) end
        local device=tostring(gethwid() or "")
        local key=saved or input.Text:match("^%s*(.-)%s*$"):upper()
        local session,err=call("/v1/activate",{key=key,device=device,product="breaker"})
        if not session then
            if rejected[err] and (saved or key==cachedKey()) then clearKey() end
            error(messages[err] or err,0)
        end
        saveKey(key)
        local credential={session=session.session,device=device,product="breaker"}
        status.Text="License verified. Loading hub..."
        local source,downloadError=call("/v1/script",credential)
        if not source then error(messages[downloadError] or downloadError,0) end
        local run,parseError=loadstring(source,"Itachi Hub · Licensed Breaker")
        if not run then error("Script could not be compiled: "..tostring(parseError),0) end
        local loading=true
        task.delay(8,function()
            if loading and gui.Parent then gui.Enabled=true;status.Text="Key accepted. Waiting for Anime Breaker to initialize..." end
        end)
        local ran,runtime=pcall(run)
        loading=false
        if not ran then error("Hub startup failed: "..tostring(runtime),0) end
        if type(runtime)~="table" or not runtime.Ready then error("Hub did not finish loading.",0) end
        local active={alive=true,runtime=runtime};env.ItachiLicenseSession=active
        input.Text="";key=nil
        gui:Destroy();if env.ItachiKeyPrompt==gui then env.ItachiKeyPrompt=nil end
        task.spawn(function()
            local failures=0
            while active.alive and runtime.Alive do
                task.wait(60)
                if not active.alive or not runtime.Alive then break end
                local confirmed,reason=call("/v1/session",credential)
                if confirmed then failures=0 else
                    failures=failures+1
                    if reason~="NETWORK_ERROR" and reason~="RATE_LIMITED" or failures>=3 then
                        active.alive=false;pcall(runtime.Stop)
                        warn("[Itachi Hub] License validation stopped: "..tostring(reason)..". Run the key loader again.")
                        break
                    end
                end
            end
            credential=nil
        end)
    end)
    if not ok then gui.Enabled=true;status.Text=tostring(failure) end
    busy=false
end
activate.Activated:Connect(function() activateKey(nil) end)
local saved=cachedKey()
gui.Enabled=not saved
gui.Parent=player:WaitForChild("PlayerGui")
if saved then
    task.delay(2,function()
        if busy and gui.Parent then gui.Enabled=true;status.Text="Checking saved key..." end
    end)
    activateKey(saved)
end
